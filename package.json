{
  "name": "compendium-primaire-app",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "PWA hors ligne : maths primaire (CE1-CM2), pilote chapitre 1 Numération",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "icons": "node scripts/make-icons.mjs",
    "dev": "npm run content && vite",
    "build": "npm run content && tsc --noEmit && vite build",
    "preview": "vite preview --port 4174 --strictPort",
